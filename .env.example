# OpenClaw .env example
#
# Quick start:
# 1) Copy this file to `.env` (for local runs from this repo), OR to `~/.openclaw/.env` (for launchd/systemd daemons).
# 2) Fill only the values you use.
# 3) Keep real secrets out of git.
#
# Env-source precedence for environment variables (highest -> lowest):
# process env, ./.env, ~/.openclaw/.env, then openclaw.json `env` block.
# Existing non-empty process env vars are not overridden by dotenv/config env loading.
# Note: direct config keys (for example `gateway.auth.token` or channel tokens in openclaw.json)
# are resolved separately from env loading and often take precedence over env fallbacks.

# -----------------------------------------------------------------------------
# Gateway auth + paths
# -----------------------------------------------------------------------------
# Required if the gateway binds beyond loopback. Leave blank to have OpenClaw
# auto-generate a token on first start, or provide your own using
# `openssl rand -hex 32`. The gateway will refuse to start if this is set to
# the documented example placeholder, so never copy-paste an example value
# from docs or tutorials into this file verbatim.
OPENCLAW_GATEWAY_TOKEN=

# Optional alternative auth mode (use token OR password).
# OPENCLAW_GATEWAY_PASSWORD=

# Optional path overrides (defaults shown for reference).
# OPENCLAW_STATE_DIR=~/.openclaw
# OPENCLAW_CONFIG_PATH=~/.openclaw/openclaw.json
# OPENCLAW_HOME=~
# Docker setup stores auth profile encryption key material outside the mounted
# OpenClaw state dir and mounts this host directory into the container.
# OPENCLAW_AUTH_PROFILE_SECRET_DIR=/absolute/path/to/.openclaw-auth-profile-secrets

# Allowlist of extra directories that `$include` directives in openclaw.json may
# resolve files from. Path-list separated (':' on POSIX, ';' on Windows). Each
# entry is tilde-expanded. Without this, `$include` is confined to the directory
# containing openclaw.json.
# OPENCLAW_INCLUDE_ROOTS=/etc/openclaw/shared:~/.openclaw/shared

# Optional: import missing keys from your login shell profile.
# OPENCLAW_LOAD_SHELL_ENV=1
# OPENCLAW_SHELL_ENV_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Model provider API keys (set at least one)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
# OPENCLAW_LIVE_OPENAI_KEY=sk-...
# OPENCLAW_LIVE_ANTHROPIC_KEY=sk-ant-...
# OPENCLAW_LIVE_GEMINI_KEY=...
# OPENAI_API_KEY_1=...
# ANTHROPIC_API_KEY_1=...
# GEMINI_API_KEY_1=...
# GOOGLE_API_KEY=...
# OPENAI_API_KEYS=sk-1,sk-2
# ANTHROPIC_API_KEYS=sk-ant-1,sk-ant-2
# GEMINI_API_KEYS=key-1,key-2

# Optional additional providers
# ZAI_API_KEY=...
# AI_GATEWAY_API_KEY=...
# TOKENHUB_API_KEY=...
# LKEAP_API_KEY=...
# MINIMAX_API_KEY=...
# SYNTHETIC_API_KEY=...

# -----------------------------------------------------------------------------
# Channels (only set what you enable)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# Optional channel env fallbacks
# MATTERMOST_BOT_TOKEN=...
# MATTERMOST_URL=https://chat.example.com
# ZALO_BOT_TOKEN=...
# OPENCLAW_TWITCH_ACCESS_TOKEN=oauth:...

# -----------------------------------------------------------------------------
# Tools + voice/media (optional)
# -----------------------------------------------------------------------------
# BRAVE_API_KEY=...
# PERPLEXITY_API_KEY=pplx-...
# FIRECRAWL_API_KEY=...

# ELEVENLABS_API_KEY=...
# XI_API_KEY=...  # alias for ElevenLabs
# INWORLD_API_KEY=...
# DEEPGRAM_API_KEY=...

# =============================================================================
# Cupcake-Opolis specific variables (Tier 1-3 additions)
# =============================================================================

# ── Activity Logger (Tier 1) ──────────────────────────────────────────────────
CUPCAKE_ACTIVITY_LOG=1
# CUPCAKE_ACTIVITY_LOG_FILE=~/.openclaw/logs/activity.jsonl
# CUPCAKE_ACTIVITY_LOG_MAX_CONTENT=2048

# ── Nightly Heartbeat (Tier 1) ────────────────────────────────────────────────
CUPCAKE_HEARTBEAT_ENABLED=true
# CUPCAKE_HEARTBEAT_CRON="0 2 * * *"
# CUPCAKE_HEARTBEAT_TZ=America/Chicago
# CUPCAKE_HEARTBEAT_TELEGRAM_ID=          ← your Telegram chat_id for nightly digest
# CUPCAKE_HEARTBEAT_CHANNEL=telegram

# ── Claude Max Proxy (Tier 1) ─────────────────────────────────────────────────
# CUPCAKE_MAX_PROXY_ENABLED=true
# CUPCAKE_MAX_PROXY_SESSION_KEY=sk-ant-sid01-...   ← from claude.ai cookies
# CUPCAKE_MAX_PROXY_PORT=7199
# CUPCAKE_MAX_PROXY_ORG_ID=                         ← Team/Enterprise only

# ── here.now Artifact Publisher (Tier 1) ─────────────────────────────────────
# HERE_NOW_BACKEND=transfer                          ← transfer | gist | fly
# HERE_NOW_TRANSFER_URL=https://transfer.sh
# GITHUB_TOKEN=ghp_...                               ← for gist backend
# FLY_API_TOKEN=FlyV1_...                            ← for fly backend
# FLY_APP_NAME=cupcake-opolis

# ── Thread Router (Tier 2) ────────────────────────────────────────────────────
# CUPCAKE_THREAD_CONFIG=~/.openclaw/thread-routing.json

# ── Task Queue / Subagent Delegation (Tier 2) ────────────────────────────────
# CUPCAKE_TASK_QUEUE_MAX_CONCURRENT=3
# CUPCAKE_TASK_QUEUE_TIMEOUT_MS=300000

# ── Voice Transcription (Tier 2) ─────────────────────────────────────────────
# DEEPGRAM_API_KEY=...                               ← primary transcription
# DEEPGRAM_MODEL=nova-3
# OPENAI_API_KEY=sk-...                              ← Whisper fallback
# OPENAI_WHISPER_MODEL=whisper-1
# WHISPER_CPP_PATH=/usr/local/bin/whisper            ← local offline fallback
# CUPCAKE_VOICE_LANGUAGE=en
# CUPCAKE_VOICE_MAX_FILE_MB=25

# ── Model Prompt Overrides (Tier 2) ──────────────────────────────────────────
# CUPCAKE_PROMPTS_DIR=./prompts
# CUPCAKE_PROMPT_CLAUDE=./prompts/claude-prompt.md
# CUPCAKE_PROMPT_GROK=./prompts/grok-prompt.md
# CUPCAKE_PROMPT_QWEN=./prompts/qwen-prompt.md

# ── Runtime Governance (Tier 3) ──────────────────────────────────────────────
# CUPCAKE_SPENDING_CAP_SESSION_USD=1.00
# CUPCAKE_SPENDING_CAP_DAILY_USD=10.00
# CUPCAKE_RATE_LIMIT_MSG_PER_MIN=20
# CUPCAKE_LOOP_DETECTION_THRESHOLD=5
# CUPCAKE_GOVERNANCE_ALERT_TELEGRAM_ID=              ← alert destination

# ── Observability (Tier 3) ────────────────────────────────────────────────────
# CUPCAKE_METRICS_ENABLED=true
# CUPCAKE_METRICS_FILE=~/.openclaw/logs/metrics.jsonl
# CUPCAKE_WEEKLY_DIGEST_TELEGRAM_ID=

# ── PII Redaction (Tier 3) ────────────────────────────────────────────────────
# CUPCAKE_PII_REDACTION_ENABLED=true
# CUPCAKE_PII_ALLOWLIST=company.com,hales.ai

# ── Permissions (Tier 3) ─────────────────────────────────────────────────────
# CUPCAKE_PERMISSIONS_CONFIG=~/.openclaw/permissions.yml
